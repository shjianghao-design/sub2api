# =============================================================================
# Sub2API Local Docker Development Environment
# =============================================================================

# Web ports exposed on the host.
FRONTEND_BIND_HOST=127.0.0.1
VITE_DEV_PORT=3000
BACKEND_BIND_HOST=127.0.0.1
SERVER_PORT=8080

# Optional host access to development data services.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_HOST_PORT=5433
REDIS_BIND_HOST=127.0.0.1
REDIS_HOST_PORT=6380

# Database and Redis.
POSTGRES_USER=sub2api
POSTGRES_PASSWORD=sub2api_dev_password
POSTGRES_DB=sub2api
REDIS_PASSWORD=
REDIS_DB=0

# First-run admin account. Change before sharing the environment.
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=sub2api_dev_admin

# Fixed local secrets keep sessions and 2FA stable across container restarts.
# Replace these for any non-local environment.
JWT_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
TOTP_ENCRYPTION_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# Runtime behavior.
RUN_MODE=standard
TZ=Asia/Shanghai
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# Frontend dev server.
VITE_API_BASE_URL=/api/v1
CHOKIDAR_USEPOLLING=true

# Optional proxy for online update/pricing fetches.
UPDATE_PROXY_URL=
