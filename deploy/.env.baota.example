# =============================================================================
# Sub2API Baota Production Environment
# =============================================================================

# Custom image metadata.
APP_IMAGE=sub2api-custom
APP_TAG=latest
APP_VERSION=custom
APP_COMMIT=baota

# Server. With network_mode=host, binding to 127.0.0.1 keeps Sub2API behind
# Baota/Nginx reverse proxy instead of exposing it directly.
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
RUN_MODE=standard
TZ=Asia/Shanghai

# Baota PostgreSQL. Create this database/user in Baota before first start.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_USER=sub2api
DATABASE_PASSWORD=CHANGE_ME_DB_PASSWORD
DATABASE_DBNAME=sub2api
DATABASE_SSLMODE=disable

# Baota Redis. Leave REDIS_PASSWORD empty if Redis has no password.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# First-run admin account. ADMIN_PASSWORD is only used when the DB has no users.
ADMIN_EMAIL=admin@sub2api.local
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Required fixed secrets. Generate each with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_HEX_CHARS
TOTP_ENCRYPTION_KEY=CHANGE_ME_64_HEX_CHARS
JWT_EXPIRE_HOUR=24

# Build mirrors for mainland China servers.
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn

# Optional proxy for update/pricing fetches.
UPDATE_PROXY_URL=
